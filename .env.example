# Copy this file to %USERPROFILE%\.claude-telegram\.env and fill it in.
# Never commit the real .env: it contains your bot token.

# Token from @BotFather, looks like 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id (ask @userinfobot). Only this account can use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Language of the bot's messages: en or nl (default: en)
BRIDGE_LANGUAGE=en

# Your name, used in messages ("Hi <name>") and in what Claude sees ("Message from <name> via Telegram")
BRIDGE_OWNER_NAME=
